<div class="row">
  <div class="col-lg-6 mx-auto">
    <div class="pos-card">
      <div class="pos-card-header">
        <div class="header-left">
          <span class="header-icon">◈</span>
          <span>Agregar Producto</span>
        </div>
      </div>
      <div class="pos-card-body">
        {{#if mensaje}}
          <div style="background: #1a3a2a; border: 1px solid #00ff88; color: #00ff88; padding: 12px 16px; border-radius: 8px; margin-bottom: 16px;">
            ✓ {{mensaje}}
          </div>
        {{/if}}
        {{#if error}}
          <div class="alert-pos alert-pos-danger" style="margin-bottom: 16px;">
            ⚠ {{error}}
          </div>
        {{/if}}
        <form method="POST" action="/productos/crear">
          <div style="margin-bottom: 16px;">
            <label style="display:block; margin-bottom:6px; color:#aaa;">Nombre</label>
            <input type="text" name="nombre" required placeholder="Ej: Arroz 1kg"
              style="width:100%; padding:10px; border:1px solid #333; border-radius:6px; background:#1a1a2e; color:#fff;" />
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display:block; margin-bottom:6px; color:#aaa;">Código de Barras</label>
            <input type="text" name="codigo_barras" required placeholder="Ej: 750123456792"
              style="width:100%; padding:10px; border:1px solid #333; border-radius:6px; background:#1a1a2e; color:#fff;" />
          </div>
          <div style="margin-bottom: 16px;">
            <label style="display:block; margin-bottom:6px; color:#aaa;">Precio</label>
            <input type="number" name="precio" required step="0.01" min="0" placeholder="Ej: 22.00"
              style="width:100%; padding:10px; border:1px solid #333; border-radius:6px; background:#1a1a2e; color:#fff;" />
          </div>
          <div style="margin-bottom: 24px;">
            <label style="display:block; margin-bottom:6px; color:#aaa;">Stock</label>
            <input type="number" name="stock" required min="0" placeholder="Ej: 20"
              style="width:100%; padding:10px; border:1px solid #333; border-radius:6px; background:#1a1a2e; color:#fff;" />
          </div>
          <button type="submit" class="btn-confirm" style="width:100%;">
            ✓ Guardar Producto
          </button>
        </form>
        <a href="/" style="display:block; text-align:center; margin-top:16px; color:#aaa;">← Volver al catálogo</a>
      </div>
    </div>
  </div>
</div>