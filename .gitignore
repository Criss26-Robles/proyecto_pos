# ============================================================
# Proyecto POS — .gitignore raíz
# ============================================================

# --- Entornos y credenciales sensibles ---
.env
.env.*
!.env.example
*.env
credentials
.aws/credentials
.aws/config

# --- Node.js (pos_frontend) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Artefactos de build Maven (pos_backend, sales-api-serverless) ---
target/
!.mvn/wrapper/maven-wrapper.jar

# --- JARs compilados ---
*.jar
*.war
*.ear

# --- Artefactos de AWS SAM ---
.aws-sam/build/
.aws-sam/

# --- Archivos de caché de jqwik (property-based testing) ---
.jqwik-database

# --- IDEs ---
.idea/
.vscode/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
*.swp
*.swo

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride

# --- Windows ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs ---
*.log
logs/

# --- Archivos temporales ---
*.tmp
*.bak
*.orig

# --- Cobertura de pruebas ---
coverage/
lcov-report/
*.lcov

# --- Postman (workspace config) ---
.postman/
postman/globals/
postman/screenshots/
